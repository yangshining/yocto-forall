# STM32MP-specific BitBake settings
PREFERRED_PROVIDER_virtual/kernel = "linux-stm32mp"
PREFERRED_PROVIDER_virtual/bootloader = "u-boot-stm32mp"
PREFERRED_PROVIDER_u-boot = "u-boot-stm32mp"

# STM32MP BSP uses systemd
DISTRO_FEATURES:append = " systemd usrmerge"
VIRTUAL-RUNTIME_init_manager = "systemd"
VIRTUAL-RUNTIME_initscripts = "systemd-compat-units"

# STM32MP157F-EV1 supports eMMC boot through the vendor FlashLayout flow.
BOOTDEVICE_LABELS:append:stm32mp15-eval = " emmc"
